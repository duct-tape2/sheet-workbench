{
  "name": "sheet-workbench",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "Keep your spreadsheets. Lose the busywork.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "demo:team": "npm run build && tsx scripts/dev-team.ts",
    "test:native": "tsx scripts/native-smoke.ts",
    "build": "tsc --noEmit && vite build",
    "build:static-demo": "tsc --noEmit && vite build --mode static-demo",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:static-demo": "playwright test -c playwright.static-demo.config.ts",
    "check": "npm run build && npm test",
    "start": "tsx apps/server/src/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "^1.7.3",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.42.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
