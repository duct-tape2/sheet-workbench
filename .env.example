# Copy to .env for the alpha Compose trial, then replace every replace-me value.
# This file contains placeholders only; Compose does not generate secrets.

WEB_PORT=3001

POSTGRES_DB=sheet_workbench
POSTGRES_USER=sheet_workbench
POSTGRES_PASSWORD=replace-me-with-a-random-database-password

# Use http://localhost:3001 only for a local trial. Use the public HTTPS
# origin for a real deployment and keep the browser and /api same-origin.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Optional exact comma-separated origins; defaults to BETTER_AUTH_URL origin.
# For Vite+API development: http://localhost:5173,http://localhost:3001
TRUSTED_ORIGINS=

# Optional email verification delivery. Without this, password sign-in can
# work for a self-hosted trial but invitation verification is not deliverable.
EMAIL_VERIFICATION_WEBHOOK_URL=

# Optional Google OAuth. Do not fill these until the live Google gate is ready.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Picker configuration used by the current server. Do not fill these until
# the live OAuth/Picker gate is ready.
GOOGLE_APP_ID=
GOOGLE_PICKER_DEVELOPER_KEY=
